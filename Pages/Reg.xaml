<Page x:Class="RecipeBook.Pages.Reg"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Reg">
    <Grid Margin="20">
        <Border Style="{StaticResource CardBorderStyle}" MaxWidth="680" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Регистрация автора" FontSize="24" FontWeight="Bold" Margin="6"/>
                <UniformGrid Columns="2">
                    <StackPanel>
                        <TextBlock Text="Имя пользователя" Margin="6,8,6,0"/>
                        <TextBox x:Name="TbUserName"/>
                        <TextBlock Text="Логин" Margin="6,8,6,0"/>
                        <TextBox x:Name="TbLogin"/>
                        <TextBlock Text="Пароль" Margin="6,8,6,0"/>
                        <PasswordBox x:Name="PbPassword"/>
                        <TextBlock Text="Подтверждение пароля" Margin="6,8,6,0"/>
                        <PasswordBox x:Name="PbPasswordConfirm"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Дата рождения" Margin="6,8,6,0"/>
                        <DatePicker x:Name="DpBirthDate" Margin="6"/>
                        <TextBlock Text="Стаж (лет)" Margin="6,8,6,0"/>
                        <TextBox x:Name="TbExp"/>
                        <TextBlock Text="Email" Margin="6,8,6,0"/>
                        <TextBox x:Name="TbEmail"/>
                        <TextBlock Text="Телефон" Margin="6,8,6,0"/>
                        <TextBox x:Name="TbPhone"/>
                    </StackPanel>
                </UniformGrid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Button Content="Зарегистрироваться" Width="180" Click="BtnCreate_OnClick"/>
                    <Button Content="Назад" Width="120" Click="BtnBack_OnClick"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
