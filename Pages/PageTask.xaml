<Page x:Class="RecipeBook.Pages.PageTask"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:RecipeBook.Pages"
      Title="PageTask">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorderStyle}">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBox x:Name="TbSearch" Width="240" TextChanged="FilterChanged" ToolTip="Поиск"/>
                    <ComboBox x:Name="CbCategory" Width="180" SelectionChanged="FilterChanged" DisplayMemberPath="Name"/>
                    <ComboBox x:Name="CbSort" Width="170" SelectionChanged="FilterChanged">
                        <ComboBoxItem Content="Без сортировки" IsSelected="True"/>
                        <ComboBoxItem Content="Время ↑"/>
                        <ComboBoxItem Content="Время ↓"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock x:Name="TbCounter" VerticalAlignment="Center" Margin="8"/>
                    <Button Content="Список" Click="BtnList_OnClick"/>
                    <Button Content="Плитка" Click="BtnTile_OnClick"/>
                    <Button Content="Добавить рецепт" Click="BtnAdd_OnClick"/>
                    <Button Content="Избранное" Click="BtnLike_OnClick"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <ListView x:Name="LvRecipes" MouseDoubleClick="LvRecipes_MouseDoubleClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding PreviewPath}" Height="90" Width="110" Stretch="UniformToFill"/>
                                <StackPanel Grid.Column="1" Margin="8,0">
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="18"/>
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxHeight="50"/>
                                    <TextBlock Text="{Binding CookingTimeMinutes, StringFormat='Время: {0} мин.'}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Редактировать" Tag="{Binding RecipeId}" Click="EditRecipe_OnClick"/>
                                    <Button Content="В избранное" Tag="{Binding RecipeId}" Click="LikeRecipe_OnClick"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ScrollViewer x:Name="TileView" Visibility="Collapsed">
                <ItemsControl x:Name="IcRecipes" MouseDoubleClick="IcRecipes_MouseDoubleClick">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorderStyle}" Width="280">
                                <StackPanel>
                                    <Image Source="{Binding PreviewPath}" Height="130" Stretch="UniformToFill"/>
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Margin="0,8,0,0"/>
                                    <TextBlock Text="{Binding Description}" MaxHeight="60" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
