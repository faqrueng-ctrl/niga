<Page x:Class="RecipeBook.Pages.Autorization"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Autorization">
    <Grid>
        <Border Style="{StaticResource CardBorderStyle}" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Вход в приложение" FontSize="26" FontWeight="SemiBold" Margin="6"/>
                <TextBlock Text="Логин" Margin="6,12,6,2"/>
                <TextBox x:Name="TbLogin"/>
                <TextBlock Text="Пароль" Margin="6,12,6,2"/>
                <PasswordBox x:Name="PbPassword"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button Content="Войти" Width="120" Click="BtnLogin_OnClick"/>
                    <Button Content="Регистрация" Width="120" Click="BtnReg_OnClick"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
